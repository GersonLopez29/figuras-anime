# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# sqlite (desarrollo local antiguo, ya no se usa en producción)
*.db
*.db-journal

# fotos subidas en local (en producción se guardan en Vercel Blob)
/public/uploads/*
!/public/uploads/.gitkeep

# skills de agentes de IA instalados por Prisma CLI (no forman parte de la app)
/.agents
/.claude
/.windsurf
skills-lock.json

.vercel
.env*
