// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                         String            @id @default(cuid())
  name                       String
  email                      String            @unique
  passwordHash               String
  whatsapp                   String
  role                       String            @default("user")
  isOfficialStore            Boolean           @default(false)
  isBlocked                  Boolean           @default(false)
  failedLoginAttempts        Int               @default(0)
  lockedUntil                DateTime?
  emailVerified              Boolean           @default(false)
  verificationToken          String?           @unique
  verificationTokenExpiresAt DateTime?
  resetToken                 String?           @unique
  resetTokenExpiresAt        DateTime?
  createdAt                  DateTime          @default(now())
  listings                   Listing[]
  reviewsWritten             Review[]          @relation("ReviewsWritten")
  reviewsReceived            Review[]          @relation("ReviewsReceived")
  collectionPosts            CollectionPost[]
  postComments               PostComment[]
  postRatings                PostRating[]
  postReports                PostReport[]
  categoryRequests           CategoryRequest[]
  favorites                  Favorite[]
  conversationsAsBuyer       Conversation[]    @relation("ConversationsAsBuyer")
  conversationsAsSeller      Conversation[]    @relation("ConversationsAsSeller")
  messages                   Message[]
  whatsappClicks             WhatsAppClick[]
  featureRequests            FeatureRequest[]
  consignmentRequests        ConsignmentRequest[]
}

model Favorite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  icon      String   @default("📦")
  createdAt DateTime @default(now())
}

model CategoryRequest {
  id          String    @id @default(cuid())
  name        String
  message     String
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
  requesterId String
  requester   User      @relation(fields: [requesterId], references: [id], onDelete: Cascade)
}

model CollectionPost {
  id        String                @id @default(cuid())
  caption   String
  createdAt DateTime              @default(now())
  authorId  String
  author    User                  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  images    CollectionPostImage[]
  comments  PostComment[]
  ratings   PostRating[]
  reports   PostReport[]
}

model CollectionPostImage {
  id     String         @id @default(cuid())
  url    String
  postId String
  post   CollectionPost @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model PostComment {
  id        String         @id @default(cuid())
  text      String
  createdAt DateTime       @default(now())
  authorId  String
  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  postId    String
  post      CollectionPost @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model PostRating {
  id        String         @id @default(cuid())
  value     Int
  createdAt DateTime       @default(now())
  authorId  String
  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  postId    String
  post      CollectionPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([authorId, postId])
}

model PostReport {
  id         String         @id @default(cuid())
  reason     String
  createdAt  DateTime       @default(now())
  reporterId String
  reporter   User           @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  postId     String
  post       CollectionPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([reporterId, postId])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  authorId  String
  author    User     @relation("ReviewsWritten", fields: [authorId], references: [id], onDelete: Cascade)
  sellerId  String
  seller    User     @relation("ReviewsReceived", fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([authorId, sellerId])
}

model Listing {
  id                String         @id @default(cuid())
  title             String
  description       String
  price             Float
  discountAmount    Float?
  discountExpiresAt DateTime?
  category          String
  condition         String         @default("nuevo")
  deliveryZones     String[]       @default([])
  deliveryNotes     String?
  featuredUntil     DateTime?
  isPreorder        Boolean        @default(false)
  preorderArrival   DateTime?
  preorderDeposit   Float?
  // "Separada": alguien dejó un adelanto, pero quien pague el total puede
  // comprarla igual. reservedUntil es opcional (sin fecha = hasta que se quite).
  reservedAmount    Float?
  reservedUntil     DateTime?
  // Nombre del enlace: /figura/<slug>. oldSlugs guarda los anteriores (títulos
  // cambiados) para que los enlaces ya compartidos sigan redirigiendo.
  slug              String?        @unique
  oldSlugs          String[]       @default([])
  sold              Boolean        @default(false)
  views             Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  images            ListingImage[]
  favoritedBy       Favorite[]
  conversations     Conversation[]
  whatsappClicks    WhatsAppClick[]
  featureRequests   FeatureRequest[]

  @@index([featuredUntil])
}

// Pedido de un vendedor para destacar una figura. Paga por Yape/Plin y el
// admin lo aprueba (featuredUntil se extiende N días) o lo rechaza.
model FeatureRequest {
  id         String    @id @default(cuid())
  status     String    @default("pending")
  amount     Float
  days       Int
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  listingId  String
  listing    Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

// "Te la vendemos": un coleccionista pide que la tienda venda su figura a
// cambio de una comisión.
model ConsignmentRequest {
  id             String   @id @default(cuid())
  figure         String
  details        String
  expectedPrice  Float?
  status         String   @default("nuevo")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

// Cada vez que alguien toca "Contactar por WhatsApp". El comprador puede no
// tener cuenta (userId null); la IP sirve para limitar cuántos números se
// pueden pedir por hora y así frenar bots que recolectan WhatsApps.
model WhatsAppClick {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip        String?
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([userId])
  @@index([ip, createdAt])
}

model ListingImage {
  id        String  @id @default(cuid())
  url       String
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model SiteStats {
  id          String @id
  totalVisits Int    @default(0)
}

model VisitStat {
  id      String   @id @default(cuid())
  date    DateTime
  country String
  count   Int      @default(0)

  @@unique([date, country])
}

model Conversation {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  listingId String
  listing   Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId   String
  buyer     User      @relation("ConversationsAsBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId  String
  seller    User      @relation("ConversationsAsSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@unique([listingId, buyerId, sellerId])
}

model Message {
  id             String       @id @default(cuid())
  text           String
  createdAt      DateTime     @default(now())
  readAt         DateTime?
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

model RegistrationAttempt {
  id        String   @id @default(cuid())
  ip        String
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}

model SuggestionAttempt {
  id        String   @id @default(cuid())
  ip        String
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}

model PasswordResetAttempt {
  id        String   @id @default(cuid())
  ip        String
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}
